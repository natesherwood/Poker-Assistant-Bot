{
    // Command-line Maven builds (requires `mvn` on PATH). Running and debugging from VS Code does not.
    "version": "2.0.0",
    "tasks": [
        {
            "label": "mvn: package",
            "type": "shell",
            "command": "mvn package",
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": []
        },
        {
            "label": "mvn: test",
            "type": "shell",
            "command": "mvn test",
            "group": { "kind": "test", "isDefault": true },
            "problemMatcher": []
        },
        {
            "label": "mvn: test (including slow)",
            "type": "shell",
            "command": "mvn test -DexcludedGroups=none",
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "run jar",
            "type": "shell",
            "command": "java -jar target/poker-assistant.jar",
            "dependsOn": "mvn: package",
            "problemMatcher": []
        }
    ]
}
